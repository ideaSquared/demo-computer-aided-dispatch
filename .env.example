# 127.0.0.1, not `localhost`, for every containerised dependency.
#
# `localhost` resolves to ::1 first on Windows, and Docker's published ports
# answer IPv4. The IPv6 path doesn't refuse — it hangs and then resets — so a
# connection opened over it burns the client's full connect timeout instead of
# failing fast and retrying. Warm pools hide this until something drives real
# concurrency, at which point you get intermittent
# `write CONNECT_TIMEOUT localhost:5432` from services that were fine a moment
# earlier. Naming the IPv4 address removes the ambiguity entirely.
#
# Inside Compose the service names (postgres, redis, nats) are used instead —
# this only concerns processes running on the host.

# Local development environment template.
# Copy to .env (gitignored) and adjust for your machine.

NODE_ENV=development
LOG_LEVEL=info

# Telemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=cad-local

# Databases (single Postgres, per-service schemas)
DATABASE_URL=postgres://cad:cad@127.0.0.1:5432/cad

# Redis
REDIS_URL=redis://127.0.0.1:6379

# NATS JetStream
NATS_URL=nats://127.0.0.1:4222

# Gateway
GATEWAY_HTTP_PORT=5000

# Run each service's migrations at startup. On for local dev (matches the
# dev Compose stack); off in production, where ops migrates out of band.
MIGRATE_ON_BOOT=true

# Dev-only, and only ever local. DEV_MODE mounts service-auth's /dev/* routes
# the seed script drives; DEV_AUTH_BYPASS lets the gateway accept unauthenticated
# calls. Both mirror infra/docker-compose.dev.yml. NEVER set either in production.
DEV_MODE=true
DEV_AUTH_BYPASS=true
