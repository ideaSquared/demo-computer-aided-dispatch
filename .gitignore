# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
.next/
out/
.turbo/
*.tsbuildinfo

# Coverage
coverage/
*.lcov
junit.xml

# Env
.env
.env.local
.env.*.local

# Editors
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Generated code
packages/proto/gen/
services/triage/cad/

# Python (triage-service)
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
# uv writes a lockfile on first run; pyproject.toml pins versions and the
# Dockerfile is the canonical install path — committing it here just adds
# churn. Revisit if/when we adopt uv sync as the dev workflow.
services/triage/uv.lock

# Claude Code session-local worktrees
# (agents run in isolated worktrees under .claude/worktrees/<id>/ — these
# are git's own bookkeeping, never real content to track)
.claude/worktrees/

# Docker
.docker/

# k6 load-test output (JSON summaries land here). The directory is
# committed via tools/load-tests/results/.gitkeep so the path exists.
load-results/
tools/load-tests/results/*
!tools/load-tests/results/.gitkeep

