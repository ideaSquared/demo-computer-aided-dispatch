{
  "name": "@cad/proto",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "cad"
  ],
  "scripts": {
    "build": "pnpm gen && tsup",
    "typecheck": "pnpm gen && tsc --noEmit",
    "test": "vitest run",
    "gen": "buf generate",
    "lint:proto": "buf lint",
    "clean": "rm -rf dist gen .turbo"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.10.0",
    "@grpc/grpc-js": "^1.13.6"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.70.0",
    "@cad/tsconfig": "workspace:*",
    "ts-proto": "^2.7.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
