{
  "name": "@cad/lib.ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "sideEffects": ["**/*.css.ts"],
  "exports": {
    ".": "./src/index.ts",
    "./styles/theme.css": "./src/styles/theme.css.ts",
    "./styles/reset.css": "./src/styles/reset.css.ts"
  },
  "files": ["src"],
  "scripts": {
    "build": "echo 'source-only package; consumers compile via Vite + @vanilla-extract/vite-plugin'",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf .turbo"
  },
  "peerDependencies": {
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "dependencies": {
    "@vanilla-extract/css": "^1.16.0",
    "@vanilla-extract/recipes": "^0.5.5"
  },
  "devDependencies": {
    "@cad/tsconfig": "workspace:*",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vanilla-extract/vite-plugin": "^5.2.2",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vitest": "^3.2.6"
  }
}
