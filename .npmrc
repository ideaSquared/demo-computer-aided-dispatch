# pnpm 11 enables a 24h minimum-release-age supply-chain gate by default,
# which rejects fresh-from-the-registry packages. For an exploration project
# we want to ride latest; the lockfile commits the exact resolved versions
# so we get reproducibility either way. Relax to 0 and rely on the lockfile.
minimum-release-age=0

# Required for pnpm to run postinstall scripts of trusted packages.
# Mirrors pnpm.onlyBuiltDependencies in package.json.
auto-install-peers=true
